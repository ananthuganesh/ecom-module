# App
NODE_ENV=production
ENVIRONMENT=production
PORT=8000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/urbanaana

# Auth
JWT_SECRET=change-me

# URLs (localhost + production)
NEXT_PUBLIC_API_URL=/api
PUBLIC_WEB_URL=https://urbanaana.com
INTERNAL_BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://urbanaana.com,https://www.urbanaana.com,https://api.urbanaana.com

# Catalog
STORE_CATALOG_REVALIDATE=60
STORE_FILTERS_REVALIDATE=300
STORE_HOME_PAGE_SIZE=12
STORE_CATALOG_PAGE_SIZE=40
STORE_CATEGORY_PAGE_SIZE=100
STORE_CARD_PRIORITY_COUNT=4

# Payments
RAZORPAY_LIVE_API_KEY=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp
AISENSY_API_KEY=
AISENSY_PROJECT_ID=
AISENSY_PROJECT_API_KEY=

# Storage
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_KEY_PREFIX=urban-aana/app

# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-pro-image
AI_STUDIO_STYLE_PROMPT=First image is the style/scene reference. Match its lighting, background, and mood.
AI_STUDIO_PROMPT=Second image is the t-shirt front. Third image is the t-shirt back. Generate a polished product photo while keeping the garment print, color, and fit accurate.

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
