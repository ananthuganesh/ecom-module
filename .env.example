# App
NODE_ENV=production
ENVIRONMENT=production
PORT=8000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/urbanaana

# Auth
JWT_SECRET=change-me

# URLs (localhost + production)
NEXT_PUBLIC_API_URL=/api
PUBLIC_WEB_URL=https://urbanaana.com
INTERNAL_BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://urbanaana.com,https://www.urbanaana.com,https://api.urbanaana.com

# Catalog
STORE_CATALOG_REVALIDATE=60
STORE_FILTERS_REVALIDATE=300
STORE_HOME_PAGE_SIZE=12
STORE_CATALOG_PAGE_SIZE=40
STORE_CATEGORY_PAGE_SIZE=100
STORE_CARD_PRIORITY_COUNT=4

# Payments
RAZORPAY_LIVE_API_KEY=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp
AISENSY_API_KEY=
AISENSY_PROJECT_ID=
AISENSY_PROJECT_API_KEY=

# Shipping
DTDC_API_KEY=
DTDC_CUST_CODE=
DTDC_TRACKING_TOKEN=
DTDC_SERVICE_TYPE=B2C PRIORITY
DTDC_SERVICE_TYPE_ID=B2C PRIORITY
ABANDONED_ORDER_MINUTES=30

# Origin
ORIGIN_NAME=
ORIGIN_PHONE=
ORIGIN_PINCODE=
ORIGIN_ADDRESS=
ORIGIN_CITY=
ORIGIN_STATE=

# Storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_KEY_PREFIX=urban-aana/app

# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-pro-image
AI_STUDIO_STYLE_PROMPT=First image is the style/scene reference. Match its lighting, background, and mood.
AI_STUDIO_PROMPT=Second image is the t-shirt front. Third image is the t-shirt back. Generate a polished product photo while keeping the garment print, color, and fit accurate.

# Email
RESEND_API_KEY=
RESEND_FROM=Urban Aana <noreply@urbanaana.com>
STAFF_ORDER_EMAIL=info@bridnetwork.com

# Marketing
GTM_ID=
GTM_ENABLED=true
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GTM_ENABLED=true

# Analytics
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GA4_CREDENTIALS_FILE=
GA4_ENABLED=true

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
