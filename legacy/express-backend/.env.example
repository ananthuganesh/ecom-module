NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=your_super_secret_jwt_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ────────────────────────────────────────────────────────────────────────
# RAZORPAY CONFIGURATION
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys in development (start with rzp_test_)
# Use live keys in production (start with rzp_live_)
# ────────────────────────────────────────────────────────────────────────

# SAFE TO SEND TO FRONTEND - used to initialize the Razorpay checkout UI
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# SECRET - NEVER expose this to frontend or commit to git!
# Used for: creating orders, verifying payment signatures
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# WEBHOOK SECRET - set this in Razorpay Dashboard → Webhooks → your webhook → Secret
# Used to verify that webhook calls are genuinely from Razorpay (not a hacker)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
     