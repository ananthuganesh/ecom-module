NODE_ENV=production
ENVIRONMENT=production
MONGO_URI=mongodb://127.0.0.1:27017/urbanaana
JWT_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AISENSY_API_KEY=
AISENSY_PROJECT_ID=
AISENSY_PROJECT_API_KEY=
DTDC_API_KEY=
DTDC_CUST_CODE=
DTDC_TRACKING_TOKEN=
DTDC_SERVICE_TYPE=B2C PRIORITY
DTDC_SERVICE_TYPE_ID=B2C PRIORITY
# Unpaid Razorpay exits → order status "abandoned" after N minutes (default 30; aligns with stock reserve TTL).
# AiSensy abandoned-cart WhatsApp delay is separate (admin AiSensy abandonedMinutes, default 15).
ABANDONED_ORDER_MINUTES=30
ORIGIN_NAME=
ORIGIN_PHONE=
ORIGIN_PINCODE=
ORIGIN_ADDRESS=
ORIGIN_CITY=
ORIGIN_STATE=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Public base without trailing slash. Prefer https://pub-<hash>.r2.dev (no bucket suffix).
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# Optional key root (e.g. urban-aana) so objects live under {prefix}/products|ai/
R2_KEY_PREFIX=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-pro-image
# AI Studio prompts (server-only; not editable in admin UI)
AI_STUDIO_STYLE_PROMPT=First image is the style/scene reference. Match its lighting, background, and mood.
AI_STUDIO_PROMPT=Second image is the t-shirt front. Third image is the t-shirt back. Generate a polished product photo while keeping the garment print, color, and fit accurate.
# Public storefront URL (SEO, emails, abandoned-cart links)
PUBLIC_WEB_URL=https://urbanaana.com
# Resend transactional email (order placed / confirmed / shipped / delivered + abandoned cart)
RESEND_API_KEY=
RESEND_FROM=Urban Aana <noreply@urbanaana.com>
STAFF_ORDER_EMAIL=info@bridnetwork.com
# Google Analytics Data API (admin Analytics traffic section)
GA4_PROPERTY_ID=
# Paste full service-account JSON as one line, or set GA4_CREDENTIALS_FILE=/path/to/key.json
GA4_CREDENTIALS_JSON=
GA4_CREDENTIALS_FILE=
GA4_ENABLED=true

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
